{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", {
      "js": "always"
    }],
    "no-console": "off"
  }
}
